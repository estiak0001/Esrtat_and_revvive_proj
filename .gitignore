# ── Secrets — never commit real env files ────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
build/

# ── Uploaded user content (lives on the server, not in source control) ────────
backend/uploads/
uploads/

# ── Local tooling ─────────────────────────────────────────────────────────────
.claude/

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── One-off local debug/ops scripts (some embed live server credentials) ──────
esrat-associates/check_dns.py
esrat-associates/find_url.py
esrat-associates/find_url2.py
esrat-associates/fix_nginx.py
esrat-associates/fix_uploads_nginx.py
