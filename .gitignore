# ── Secrets — never commit real env files ────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
build/

# ── Uploaded user content (lives on the server, not in source control) ────────
backend/uploads/
uploads/

# ── Local tooling ─────────────────────────────────────────────────────────────
.claude/

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

